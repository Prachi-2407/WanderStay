<% layout("/layouts/boilerplate") %>

<style>
  .bookings-container {
    max-width: 1000px;
    margin: 2rem auto;
  }

  .booking-card {
    border: 1px solid #e5e5e5;
    border-radius: 1rem;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin-bottom: 1.5rem;
  }

  .booking-card:hover {
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }

  .booking-img-col {
    height: 100%;
    min-height: 200px;
  }

  .booking-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .empty-bookings {
    text-align: center;
    padding: 5rem 2rem;
    background: #f8f9fa;
    border-radius: 1.5rem;
    margin: 2rem 0;
  }

  .status-badge {
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
    border-radius: 20px;
    font-weight: 600;
  }
</style>

<div class="bookings-container">
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h2 class="fw-bold mb-1"><i class="fa-solid fa-suitcase-rolling text-danger me-2"></i>My Bookings</h2>
      <p class="text-muted mb-0"><%= bookings.length %> total trip<%= bookings.length === 1 ? '' : 's' %></p>
    </div>
    <a href="/listings" class="btn btn-outline-dark rounded-pill px-3">
      <i class="fa-solid fa-compass me-1"></i>Explore more stays
    </a>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="empty-bookings shadow-sm">
      <i class="fa-solid fa-plane-departure fa-4x text-muted mb-3"></i>
      <h3>No trips booked... yet!</h3>
      <p class="text-muted">Time to dust off your bags and start planning your next getaway.</p>
      <a href="/listings" class="btn btn-dark rounded-pill px-4 mt-2">Start Exploring</a>
    </div>
  <% } else { %>
    <% for (let b of bookings) { %>
      <% const listing = b.listing; %>
      <div class="card booking-card shadow-sm">
        <div class="row g-0">
          <div class="col-md-4 booking-img-col">
            <% if (listing && listing.image && listing.image.url) { %>
              <a href="/listings/<%= listing._id %>">
                <img src="<%= listing.image.url %>" class="booking-img" alt="<%= listing.title %>">
              </a>
            <% } else { %>
              <div class="bg-secondary text-white d-flex align-items-center justify-content-center h-100">
                <i class="fa-solid fa-image fa-2x"></i>
              </div>
            <% } %>
          </div>

          <div class="col-md-8">
            <div class="card-body p-4 d-flex flex-column justify-content-between h-100">
              <div>
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                  <h5 class="card-title fw-bold mb-0">
                    <% if (listing) { %>
                      <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                        <%= listing.title %>
                      </a>
                    <% } else { %>
                      <span class="text-muted">Listing no longer available</span>
                    <% } %>
                  </h5>
                  <% if (b.status === 'confirmed') { %>
                    <span class="status-badge bg-success-subtle text-success border border-success-subtle">
                      <i class="fa-solid fa-circle-check me-1"></i>Confirmed
                    </span>
                  <% } else { %>
                    <span class="status-badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                      <i class="fa-solid fa-ban me-1"></i>Cancelled
                    </span>
                  <% } %>
                </div>

                <% if (listing) { %>
                  <p class="text-muted small mb-3">
                    <i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %>
                  </p>
                <% } %>

                <div class="row g-3 py-2 border-top border-bottom my-2 small">
                  <div class="col-6 col-sm-3">
                    <span class="text-muted d-block">CHECK-IN</span>
                    <span class="fw-semibold"><%= new Date(b.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                  </div>
                  <div class="col-6 col-sm-3">
                    <span class="text-muted d-block">CHECKOUT</span>
                    <span class="fw-semibold"><%= new Date(b.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                  </div>
                  <div class="col-6 col-sm-3">
                    <span class="text-muted d-block">GUESTS</span>
                    <span class="fw-semibold"><%= b.guests %> guest<%= b.guests > 1 ? 's' : '' %></span>
                  </div>
                  <div class="col-6 col-sm-3">
                    <span class="text-muted d-block">TOTAL PRICE</span>
                    <span class="fw-bold text-dark">₹<%= b.totalPrice.toLocaleString('en-IN') %></span>
                  </div>
                </div>
              </div>

              <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                <span class="text-muted small">
                  Booked on <%= new Date(b.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                </span>
                <% if (b.status === 'confirmed') { %>
                  <form method="POST" action="/bookings/<%= b._id %>/cancel" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                      <i class="fa-regular fa-circle-xmark me-1"></i>Cancel Trip
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  <% } %>
</div>
