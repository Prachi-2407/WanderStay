<% layout("/layouts/boilerplate") %>

<style>
  .show-container {
    max-width: 1020px;
    margin: 1.5rem auto;
  }

  .show-img-container {
    border-radius: 1.25rem;
    overflow: hidden;
    height: 420px;
    position: relative;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
  }

  .show-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .booking-card {
    border: 1px solid #e0e0e0;
    border-radius: 1.2rem;
    box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    position: sticky;
    top: 6rem;
    padding: 1.5rem;
    background: #fff;
  }

  .booking-price-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid #f0f0f0;
    padding-bottom: 1rem;
    margin-bottom: 1.2rem;
  }

  .date-picker-box {
    border: 1px solid #ccc;
    border-radius: 0.75rem;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .date-picker-inner {
    display: flex;
  }

  .date-input-group {
    flex: 1;
    padding: 0.5rem 0.75rem;
  }

  .date-input-group:first-child {
    border-right: 1px solid #ccc;
  }

  .date-input-group label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #555;
    display: block;
    margin-bottom: 0.1rem;
  }

  .date-input-group input {
    border: none;
    font-size: 0.85rem;
    width: 100%;
    outline: none;
    background: transparent;
  }

  .guest-input-group {
    border-top: 1px solid #ccc;
    padding: 0.5rem 0.75rem;
  }

  .guest-input-group label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #555;
    display: block;
    margin-bottom: 0.1rem;
  }

  .guest-input-group input {
    border: none;
    font-size: 0.9rem;
    width: 100%;
    outline: none;
    background: transparent;
  }

  .reserve-btn {
    background: #fe424d;
    color: white;
    font-weight: 600;
    width: 100%;
    padding: 0.75rem;
    border-radius: 0.6rem;
    border: none;
    transition: background 0.2s ease;
  }

  .reserve-btn:hover {
    background: #e03943;
    color: white;
  }

  .price-breakdown {
    display: none;
    margin-top: 1rem;
    border-top: 1px solid #f0f0f0;
    padding-top: 1rem;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    color: #555;
    font-size: 0.95rem;
  }

  .price-total {
    border-top: 1px solid #e0e0e0;
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    font-weight: 700;
    color: #222;
    font-size: 1.1rem;
  }

  .wishlist-pill-btn {
    border: 1px solid #ccc;
    background: #fff;
    border-radius: 30px;
    padding: 0.4rem 1rem;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .wishlist-pill-btn:hover {
    border-color: #222;
    background: #f8f9fa;
  }

  .wishlist-pill-btn.favorited i {
    color: #fe424d;
  }
</style>

<div class="show-container">
  <!-- Header Title & Meta -->
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
      <h2 class="mb-1 fw-bold"><%= listing.title %></h2>
      <div class="d-flex align-items-center gap-3 text-muted flex-wrap">
        <% if (avgRating) { %>
          <span class="fw-semibold text-dark">
            <i class="fa-solid fa-star text-warning"></i> <%= avgRating %>
            <span class="text-muted fw-normal">(<%= listing.reviews.length %> review<%= listing.reviews.length === 1 ? '' : 's' %>)</span>
          </span>
          <span>•</span>
        <% } %>
        <span><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %></span>
        <% if (listing.category) { %>
          <span>•</span>
          <span class="badge bg-light text-dark border px-2 py-1"><%= listing.category %></span>
        <% } %>
      </div>
    </div>

    <!-- Wishlist Button -->
    <div>
      <button 
        type="button" 
        class="wishlist-pill-btn <%= isFavorite ? 'favorited' : '' %>"
        id="wishlistShowBtn"
        onclick="toggleShowWishlist('<%= listing._id %>')"
      >
        <i class="<%= isFavorite ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
        <span id="wishlistText"><%= isFavorite ? 'Saved' : 'Save' %></span>
      </button>
    </div>
  </div>

  <!-- Hero Image -->
  <div class="show-img-container mb-4">
    <img src="<%= listing.image.url %>" class="show-hero-img" alt="<%= listing.title %>">
  </div>

  <!-- Content & Booking Grid -->
  <div class="row">
    <!-- Left Column: Details, Reviews, Map -->
    <div class="col-lg-7 col-md-12">
      <!-- Host & Description -->
      <div class="pb-3 border-bottom mb-4">
        <h4 class="fw-semibold">Entire place hosted by <%= listing.owner ? listing.owner.username : 'Host' %></h4>
        <p class="text-muted mb-0"><%= listing.description %></p>
      </div>

      <!-- Owner Actions (Edit / Delete) -->
      <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
        <div class="d-flex gap-2 mb-4 pb-3 border-bottom">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4 rounded-pill">
            <i class="fa-regular fa-pen-to-square me-1"></i>Edit Listing
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');">
            <button class="btn btn-outline-danger px-4 rounded-pill">
              <i class="fa-regular fa-trash-can me-1"></i>Delete
            </button>
          </form>
        </div>
      <% } %>

      <!-- Reviews Section -->
      <div class="pb-4 border-bottom mb-4">
        <h4 class="fw-semibold mb-3">
          <i class="fa-regular fa-comments me-2"></i>Reviews
          <% if(listing.reviews.length > 0) { %>
            <span class="text-muted fs-6 fw-normal">(<%= listing.reviews.length %>)</span>
          <% } %>
        </h4>

        <% if(currUser) { %>
          <div class="card p-3 border-0 bg-light rounded-4 mb-4">
            <h5 class="fw-semibold mb-3">Leave a Review</h5>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
              <div class="mb-3">
                <label for="rating" class="form-label fw-semibold">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div class="mb-3">
                <label for="comment" class="form-label fw-semibold">Your Review</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control rounded-3" placeholder="Share your experience here..." required></textarea>
                <div class="invalid-feedback">Please add some comments for review</div>
              </div>

              <button class="btn btn-dark rounded-pill px-4">Submit Review</button>
            </form>
          </div>
        <% } else { %>
          <p class="text-muted mb-4"><a href="/login" class="text-dark fw-semibold">Log in</a> to leave a review.</p>
        <% } %>

        <!-- Review Cards -->
        <% if(listing.reviews.length === 0) { %>
          <p class="text-muted">No reviews yet. Be the first to leave a review!</p>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 g-3">
            <% for(let review of listing.reviews) { %>
              <div class="col">
                <div class="card h-100 p-3 border rounded-3 shadow-sm">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="d-flex align-items-center gap-2">
                      <i class="fa-solid fa-circle-user fs-4 text-secondary"></i>
                      <span class="fw-semibold">@<%= review.author ? review.author.username : 'Anonymous' %></span>
                    </div>
                    <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" onsubmit="return confirm('Delete this review?');">
                        <button class="btn btn-sm btn-link text-danger p-0" title="Delete review">
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                  <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                  <p class="text-muted mb-0 small"><%= review.comment %></p>
                </div>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- Map Section -->
      <div class="mb-5">
        <h4 class="fw-semibold mb-3"><i class="fa-solid fa-map-location-dot me-2"></i>Where you'll be</h4>
        <p class="text-muted"><%= listing.location %>, <%= listing.country %></p>
        <div id="map" class="shadow-sm"></div>
      </div>
    </div>

    <!-- Right Column: Sticky Booking / Reservation Widget -->
    <div class="col-lg-5 col-md-12">
      <div class="booking-card">
        <div class="booking-price-header">
          <div>
            <span class="fs-3 fw-bold text-dark">₹<%= listing.price.toLocaleString('en-IN') %></span>
            <span class="text-muted"> / night</span>
          </div>
          <div>
            <% if (avgRating) { %>
              <span class="fw-semibold text-dark">
                <i class="fa-solid fa-star text-warning"></i> <%= avgRating %>
              </span>
            <% } else { %>
              <span class="text-muted small">★ New</span>
            <% } %>
          </div>
        </div>

        <% if (currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
          <div class="alert alert-info rounded-3 small">
            <i class="fa-solid fa-circle-info me-1"></i> You are hosting this place. Manage reservations and bookings from your profile dashboard.
          </div>
        <% } else { %>
          <form action="/bookings/listing/<%= listing._id %>" method="POST" id="bookingForm" class="needs-validation" novalidate>
            <div class="date-picker-box">
              <div class="date-picker-inner">
                <div class="date-input-group">
                  <label for="checkIn">CHECK-IN</label>
                  <input type="date" id="checkIn" name="booking[checkIn]" required onchange="calculateBookingPrice()">
                </div>
                <div class="date-input-group">
                  <label for="checkOut">CHECKOUT</label>
                  <input type="date" id="checkOut" name="booking[checkOut]" required onchange="calculateBookingPrice()">
                </div>
              </div>
              <div class="guest-input-group">
                <label for="guests">GUESTS</label>
                <input type="number" id="guests" name="booking[guests]" value="1" min="1" max="10" required>
              </div>
            </div>

            <button type="submit" class="reserve-btn mb-2">
              <i class="fa-solid fa-calendar-check me-2"></i>Reserve
            </button>
            <p class="text-center text-muted small mb-0">You won't be charged yet</p>

            <!-- Dynamic Price Breakdown -->
            <div id="priceBreakdown" class="price-breakdown">
              <div class="price-row">
                <span id="pricePerNightLabel">₹<%= listing.price.toLocaleString('en-IN') %> x 0 nights</span>
                <span id="basePriceTotal">₹0</span>
              </div>
              <div class="price-row">
                <span>WanderStay GST (18%)</span>
                <span id="gstAmount">₹0</span>
              </div>
              <div class="price-row price-total">
                <span>Total before taxes & fees</span>
                <span id="grandTotal">₹0</span>
              </div>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  // Set minimum date to today
  const today = new Date().toISOString().split("T")[0];
  const checkInInput = document.getElementById("checkIn");
  const checkOutInput = document.getElementById("checkOut");

  if (checkInInput && checkOutInput) {
    checkInInput.min = today;
    checkInInput.addEventListener("change", () => {
      checkOutInput.min = checkInInput.value;
      if (checkOutInput.value && checkOutInput.value <= checkInInput.value) {
        checkOutInput.value = "";
      }
      calculateBookingPrice();
    });
  }

  const nightlyRate = <%= listing.price %>;

  function calculateBookingPrice() {
    const checkInVal = checkInInput ? checkInInput.value : null;
    const checkOutVal = checkOutInput ? checkOutInput.value : null;
    const breakdown = document.getElementById("priceBreakdown");

    if (!checkInVal || !checkOutVal) {
      if (breakdown) breakdown.style.display = "none";
      return;
    }

    const start = new Date(checkInVal);
    const end = new Date(checkOutVal);
    const diffTime = end.getTime() - start.getTime();
    const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

    if (nights > 0) {
      const basePrice = nightlyRate * nights;
      const gst = Math.round(basePrice * 0.18);
      const total = basePrice + gst;

      document.getElementById("pricePerNightLabel").innerText = `₹${nightlyRate.toLocaleString('en-IN')} x ${nights} night${nights > 1 ? 's' : ''}`;
      document.getElementById("basePriceTotal").innerText = `₹${basePrice.toLocaleString('en-IN')}`;
      document.getElementById("gstAmount").innerText = `₹${gst.toLocaleString('en-IN')}`;
      document.getElementById("grandTotal").innerText = `₹${total.toLocaleString('en-IN')}`;

      if (breakdown) breakdown.style.display = "block";
    } else {
      if (breakdown) breakdown.style.display = "none";
    }
  }

  // Wishlist AJAX toggle
  async function toggleShowWishlist(listingId) {
    const btn = document.getElementById("wishlistShowBtn");
    const icon = btn.querySelector("i");
    const label = document.getElementById("wishlistText");

    try {
      const response = await fetch(`/listings/${listingId}/favorite`, {
        method: "POST",
        headers: {
          "Accept": "application/json",
          "Content-Type": "application/json"
        }
      });

      if (response.redirected) {
        window.location.href = response.url;
        return;
      }

      const data = await response.json();
      if (data.success) {
        if (data.isFavorited) {
          btn.classList.add("favorited");
          icon.className = "fa-solid fa-heart";
          label.innerText = "Saved";
        } else {
          btn.classList.remove("favorited");
          icon.className = "fa-regular fa-heart";
          label.innerText = "Save";
        }
      }
    } catch (err) {
      console.error(err);
      const form = document.createElement("form");
      form.method = "POST";
      form.action = `/listings/${listingId}/favorite`;
      document.body.appendChild(form);
      form.submit();
    }
  }

  const coordinates = <%- JSON.stringify(
    listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2
      ? listing.geometry.coordinates
      : [0, 0]
  ) %>;
</script>

<script src="/js/map.js"></script>
